{
  "version": 2,
  "name": "diamonds-league",
  "framework": "flask",
  "builds": [
    { "src": "static/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/static/$1", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "src": "/(robots.txt|sitemap.xml)", "dest": "/static/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{templates/**,db/**,*.py}"
    }
  },
  "outputDirectory": "."
}