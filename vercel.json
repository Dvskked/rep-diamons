{
  "version": 2,
  "name": "diamonds-league",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/robots.txt", "destination": "/static/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/static/sitemap.xml" }
  ]
}
